// Real result-returning helpers during delayed fire feedback; no synthetic full-mixture overwrite.
/obj/item/wrench/banda_pipeline_receiver
	var/calls = 0
	var/datum/gas_mixture/received
	var/fail = TRUE
	var/effect_mc_state

/obj/item/wrench/banda_pipeline_receiver/Initialize(mapload)
	. = ..()
	received = new()

/obj/item/wrench/banda_pipeline_receiver/Destroy()
	received = null
	return ..()

/obj/item/wrench/banda_pipeline_receiver/fire_act(exposed_temperature, exposed_volume)
	calls++
	effect_mc_state = SSair.state
	var/turf/open/target = loc
	received.merge(target.remove_air(50))
	if(fail)
		throw EXCEPTION("BANDA_EXPECTED_PIPELINE_EFFECT_ERROR")

/// Observe the real asynchronous exception without allowing an expected fixture error into runtimes.
/datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe
	var/completion_error
	var/fail_collection = FALSE

/datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe/collect_pipeline_commands()
	if(fail_collection && publication_pending)
		fail_collection = FALSE
		throw EXCEPTION("BANDA_EXPECTED_PIPELINE_PUBLICATION_ERROR")
	return ..()

/datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe/finish_pipeline_calculation(cycle)
	try
		return ..()
	catch(var/exception/error)
		if(error.name != "BANDA_EXPECTED_PIPELINE_EFFECT_ERROR" && error.name != "BANDA_EXPECTED_PIPELINE_PUBLICATION_ERROR")
			throw error
		completion_error = error.name

/datum/controller/subsystem/atmos_phase_test/proc/pipeline_world_checks()
	var/list/checks = list()
	checks["pipeline_default_disabled"] = !CONFIG_GET(flag/rust_atmos_pipeline)
	CONFIG_SET(flag/rust_atmos_pipeline, TRUE)
	var/datum/banda_atmos_phase/world_adapter/unsupported = new("bandastation_atmos.dll")
	CONFIG_SET(flag/rust_atmos_pipeline, FALSE)
	checks["pipeline_requires_worker"] = !unsupported.native_ready && findtext(unsupported.startup_error, "requires the worker") > 0
	qdel(unsupported)
	var/datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe/phase = threaded_pair(230, phase_type = /datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe)
	phase.threaded = TRUE
	phase.pipelined = TRUE
	var/turf/open/left = phase.positions[1]
	var/turf/open/right = phase.positions[2]
	var/datum/gas_mixture/held = left.get_readonly_air()
	SSair.times_fired++
	checks["pipeline_launch_returns_without_effects"] = phase.start_pipeline_tick() && phase.running && !phase.pipeline_effect_packets
	var/deadline = world.time + 10 SECONDS
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_publishes_issued_alias_before_effects"] = held == left.get_readonly_air() && held.moles[/datum/gas/nitrogen] < 100 && !phase.pipeline_effect_packets
	checks["pipeline_counts_one_calculation"] = phase.completed_ticks == 1 && phase.pipeline_calculations == 1 && !phase.running && !phase.publication_pending
	checks["pipeline_defers_physical_commands"] = length(phase.deferred_commands) > 0 && !length(phase.active_commands)
	var/obj/item/wrench/banda_pipeline_receiver/probe = new(left)
	var/datum/banda_atmos_cell/cell = phase.ensure_binding(left)
	phase.deferred_commands = list(cell.native_id, cell.binding_version, 9, 700, CELL_VOLUME, cell.native_id, cell.binding_version, 9, 700, CELL_VOLUME)
	SSair.times_fired++
	phase.start_pipeline_tick()
	checks["pipeline_next_worker_precedes_old_effects"] = phase.running && length(phase.active_commands) == 10 && !probe.calls
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_error_propagates_and_skips_tail"] = phase.completion_error == "BANDA_EXPECTED_PIPELINE_EFFECT_ERROR" && probe.calls == 1 && !length(phase.active_commands)
	var/total = left.banda_atmos_cell.read_air().total_moles() + phase.ensure_binding(right).read_air().total_moles() + probe.received.total_moles()
	checks["pipeline_debit_is_conserved_after_error"] = abs(total - 110) < 0.001 && probe.received.total_moles() <= 50
	checks["pipeline_error_clears_gas_scope"] = !phase.operation_transaction && !phase.in_safe_callback && !length(phase.working_mixtures)
	phase.apply_pipeline_effects()
	checks["pipeline_error_is_not_replayed"] = probe.calls == 1
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_worker_recovers_after_effect_error"] = phase.completed_ticks == 2 && !phase.worker_cycle && !phase.running
	// A failed publication must also discard its old packet, even before the first fire_act.
	probe.fail = FALSE
	phase.deferred_commands = list(cell.native_id, cell.binding_version, 9, 700, CELL_VOLUME)
	phase.fail_collection = TRUE
	SSair.times_fired++
	phase.start_pipeline_tick()
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_publication_error_discards_old_packet"] = phase.completion_error == "BANDA_EXPECTED_PIPELINE_PUBLICATION_ERROR" && !length(phase.active_commands) && probe.calls == 1
	var/previous_completed = phase.completed_ticks
	SSair.times_fired++
	phase.start_pipeline_tick()
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_restarts_after_publication_error"] = !phase.running && !phase.worker_cycle && phase.completed_ticks == previous_completed + 1 && probe.calls == 1
	qdel(probe)
	// ChangeTurf must reject commands for the old floor, even though its coordinate survives.
	var/old_version = cell.binding_version
	left = left.ChangeTurf(/turf/open/floor/wood, flags = CHANGETURF_INHERIT_AIR)
	phase.apply_frame()
	// ChangeTurf schedules the complete map's adjacency rebuild; this fixture owns only two cells.
	left.atmos_adjacent_turfs = list(right)
	right.atmos_adjacent_turfs = list(left)
	phase.mark_topology(left)
	phase.mark_topology(right)
	probe = new(left)
	probe.fail = FALSE
	phase.deferred_commands = list(cell.native_id, old_version, 9, 700, CELL_VOLUME)
	SSair.times_fired++
	phase.start_pipeline_tick()
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_revalidates_replaced_floor"] = cell.binding_version > old_version && !probe.calls
	qdel(probe)
	// The launch finishes its MC call; the atomic packet runs after that call has returned.
	probe = new(left)
	probe.fail = FALSE
	phase.deferred_commands = list(cell.native_id, cell.binding_version, 9, 700, CELL_VOLUME)
	SSair.currentpart = SSAIR_ACTIVETURFS
	SSair.native_atoms_pending = FALSE
	SSair.adjacent_rebuild.Cut()
	SSair.times_fired++
	var/before = SSair.times_fired
	var/completed = phase.completed_ticks
	var/result = threaded_mc_fire(TRUE)
	checks["pipeline_mc_launch_finishes_without_pause"] = result == SS_RUNNING && SSair.times_fired == before + 1 && !probe.calls
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_effects_run_outside_mc_budget"] = probe.calls == 1 && probe.effect_mc_state == SS_IDLE && SSair.times_fired == before + 1 && phase.completed_ticks == completed + 1
	qdel(probe)
	qdel(phase)
	checks["pipeline_close_restores_dm_air"] = !SSair.native_atmos && !!left.air && !!right.air && !left.banda_atmos_id
	phase = threaded_pair(233, phase_type = /datum/banda_atmos_phase/world_adapter/threaded_probe/pipeline_probe)
	phase.threaded = TRUE
	phase.pipelined = TRUE
	left = phase.positions[1]
	phase.deferred_commands = list(left.banda_atmos_id, 1, 13, 300, 0)
	SSair.times_fired++
	phase.start_pipeline_tick()
	checks["pipeline_empty_exposure_overlaps_without_cache"] = phase.pipeline_empty_exposures == 1 && !length(phase.active_commands) && !left.banda_atmos_cell
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	phase.invoke(CALLBACK(src, PROC_REF(feedback_seed), left))
	var/obj/item/stack/sheet/mineral/coal/coal = new(left, 1)
	coal.anchored = TRUE
	phase.native(29, list(left.banda_atmos_id, 700, CELL_VOLUME, FALSE, TRUE, FALSE))
	phase.native(30)
	// Discard the preceding cold frame's presentation; the following two frames test real burning.
	phase.deferred_commands.Cut()
	SSair.times_fired++
	phase.start_pipeline_tick()
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_real_coal_feedback_waits_one_calculation"] = !QDELETED(coal)
	SSair.times_fired++
	phase.start_pipeline_tick()
	while(phase.worker_cycle && world.time < deadline)
		sleep(world.tick_lag)
	checks["pipeline_real_coal_feedback_reaches_fresh_gas"] = QDELETED(coal) && phase.ensure_binding(left).read_air().moles[/datum/gas/carbon_dioxide] > 0
	qdel(coal)
	qdel(phase)
	SSair.native_atoms_pending = FALSE
	SSair.currentpart = SSAIR_PIPENETS
	return checks
