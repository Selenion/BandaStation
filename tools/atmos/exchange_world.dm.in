/// Count boundary writes without replacing the real native implementation.
/datum/banda_atmos_phase/world_adapter/exchange_probe
	var/commits = 0
	var/service_publications = 0
	var/thermal_requests = 0
	var/temperature_requests = 0
	var/list/thermal_intervening_write
	var/fail_binding_id = 0
	var/fail_change_read = FALSE
	var/binding_lookups = 0
	var/last_projection_batch
	var/compact_hotspots = 0

/datum/banda_atmos_phase/world_adapter/exchange_probe/ensure_binding(turf/target)
	binding_lookups++
	return ..()

/datum/banda_atmos_phase/world_adapter/exchange_probe/native(operation, ...)
	if(operation == 40 && fail_change_read)
		fail_change_read = FALSE
		..(arglist(args))
		throw EXCEPTION("BANDA_EXPECTED_CHANGE_READ_ERROR")
	if(operation == 3 || operation == 36)
		commits++
	if(operation == 35 || operation == 53 || operation == 65 || operation == 73 || operation == 75)
		var/list/requests = args[2]
		for(var/index = 1; index <= length(requests); index += (operation == 75 ? 3 : 2))
			var/id = requests[index]
			if(fail_binding_id == id)
				fail_binding_id = 0
				if(operation != 75)
					..(arglist(args))
				throw EXCEPTION("BANDA_EXPECTED_PUBLICATION_ERROR")
			if(!requests[index + 1] && length(cells) >= id && cells[id]?.cached_air)
				service_publications++
			if(requests[index + 1] > 1)
				thermal_requests++
				if(requests[index + 1] == 3)
					temperature_requests++
				if(thermal_intervening_write)
					..(36, id, FALSE, thermal_intervening_write)
					thermal_intervening_write = null
	. = ..(arglist(args))
	if(operation == 75)
		last_projection_batch = .
	if(operation == 76 && . == 5)
		compact_hotspots++
	return .

/obj/machinery/banda_exchange_probe
	var/turf/open/air_target
	var/observed_moles
	var/safe_access = FALSE
	var/throw_after_write = FALSE

/obj/machinery/banda_exchange_probe/process_atmos(seconds_per_tick)
	safe_access = SSair.native_atmos?.in_safe_callback
	observed_moles = air_target.get_readonly_air().moles[/datum/gas/nitrogen]
	var/datum/gas_mixture/air = air_target.return_air()
	air.moles[/datum/gas/nitrogen] += 1
	if(throw_after_write)
		throw EXCEPTION("BANDA_EXCHANGE_EXPECTED_EQUIPMENT_FAILURE")
	return PROCESS_KILL

/obj/machinery/banda_exchange_probe/Destroy()
	air_target = null
	return ..()

/datum/banda_exchange_exposure_probe
	var/observed_moles

/datum/banda_exchange_exposure_probe/proc/on_exposure(turf/source, datum/gas_mixture/air, temperature)
	SIGNAL_HANDLER
	if(air)
		observed_moles = air.moles[/datum/gas/nitrogen]
		air.moles[/datum/gas/nitrogen] += 1

/datum/controller/subsystem/atmos_phase_test/proc/exposure_cache_checks()
	var/turf/open/target = floor_at(194, 182)
	var/obj/machinery/light/light = new(target)
	var/obj/structure/grille/grille = new(target)
	target.air.set_gas(/datum/gas/nitrogen, 19)
	target.air.temperature = 1800
	target.air.archive()
	target.temperature_expose(target.air, 1800)
	var/dm_light = !!(light.flags_1 & ATMOS_IS_PROCESSING_1)
	var/dm_grille = !!(grille.flags_1 & ATMOS_IS_PROCESSING_1)
	light.stop_atmos_exposure()
	grille.stop_atmos_exposure()
	target.banda_air_requested = FALSE
	var/datum/banda_atmos_phase/world_adapter/phase = new("bandastation_atmos.dll")
	SSair.native_atmos = phase
	phase.register_batch(list(target))
	phase.initializing = FALSE
	var/datum/banda_atmos_cell/cell = phase.ensure_binding(target)
	phase.invoke(CALLBACK(cell, TYPE_PROC_REF(/datum/banda_atmos_cell, execute), 13, 1800, TRUE))
	var/light_started = !!(light.flags_1 & ATMOS_IS_PROCESSING_1)
	var/grille_started = !!(grille.flags_1 & ATMOS_IS_PROCESSING_1)
	var/matches_dm = dm_light && dm_grille && light_started == dm_light && grille_started == dm_grille && !cell.cached_air
	phase.invoke(CALLBACK(cell, TYPE_PROC_REF(/datum/banda_atmos_cell, execute), 13, 300, TRUE))
	matches_dm = matches_dm && !(light.flags_1 & ATMOS_IS_PROCESSING_1) && !(grille.flags_1 & ATMOS_IS_PROCESSING_1) && !cell.cached_air
	var/datum/banda_exchange_exposure_probe/probe = new()
	probe.RegisterSignal(target, COMSIG_TURF_EXPOSE, TYPE_PROC_REF(/datum/banda_exchange_exposure_probe, on_exposure))
	phase.invoke(CALLBACK(cell, TYPE_PROC_REF(/datum/banda_atmos_cell, execute), 13, 1800, TRUE))
	var/mixed_signal = probe.observed_moles == 19 && cell.cached_air && cell.read_air().moles[/datum/gas/nitrogen] == 20
	qdel(probe)
	qdel(light)
	qdel(grille)
	qdel(phase)
	return list("temperature_only_exposure_matches_dm_without_a_cache" = matches_dm, "mixed_exposure_still_receives_live_gas" = mixed_signal)

/turf/open/floor/iron/banda_empty_exposure_probe
	var/temperature_calls = 0
	var/exposure_ends = 0

/turf/open/floor/iron/banda_empty_exposure_probe/temperature_expose(datum/gas_mixture/air, exposed_temperature, native_keys)
	temperature_calls++
	return ..()

/turf/open/floor/iron/banda_empty_exposure_probe/atmos_end()
	exposure_ends++
	return ..()

/datum/banda_empty_exposure_listener
	var/calls = 0
	var/observed_moles

/datum/banda_empty_exposure_listener/proc/exposed(turf/source, datum/gas_mixture/air, temperature)
	SIGNAL_HANDLER
	calls++
	observed_moles = air?.moles[/datum/gas/nitrogen]
	if(air)
		air.adjust_gas(/datum/gas/nitrogen, 1)

/// Compare actual native command packets with the original turf notification and queue transitions.
/datum/controller/subsystem/atmos_phase_test/proc/empty_exposure_checks()
	var/list/checks = list()
	for(var/scenario in list("empty", "held", "hot", "destroyed", "queued", "listener", "listener_changes", "gasless"))
		var/list/reference
		var/native_calls
		for(var/native in list(FALSE, TRUE))
			var/turf/open/base = floor_at(208, 183)
			var/turf/open/floor/iron/banda_empty_exposure_probe/target = base.ChangeTurf(/turf/open/floor/iron/banda_empty_exposure_probe)
			target.heat_capacity = 1000
			target.to_be_destroyed = scenario == "destroyed"
			target.air.set_gas(/datum/gas/nitrogen, 17)
			target.banda_air_requested = FALSE
			if(scenario == "queued")
				target.flags_1 |= ATMOS_IS_PROCESSING_1
				SSair.atom_process |= target
			var/datum/banda_empty_exposure_listener/listener = new()
			if(scenario == "listener")
				listener.RegisterSignal(target, COMSIG_TURF_EXPOSE, TYPE_PROC_REF(/datum/banda_empty_exposure_listener, exposed))
			var/datum/banda_atmos_phase/world_adapter/phase
			var/datum/gas_mixture/held = target.air
			if(native)
				phase = new("bandastation_atmos.dll")
				SSair.native_atmos = phase
				phase.register_batch(list(target))
				phase.initializing = FALSE
				if(scenario == "held")
					held = phase.invoke(CALLBACK(target, TYPE_PROC_REF(/atom, return_air)))
			if(scenario == "held")
				held.moles[/datum/gas/nitrogen] = 23
			var/temperature = scenario == "hot" ? 1000 : 300
			var/has_gas = scenario != "gasless"
			empty_exposure_packet(phase, target, temperature, has_gas)
			if(scenario == "listener_changes")
				listener.RegisterSignal(target, COMSIG_TURF_EXPOSE, TYPE_PROC_REF(/datum/banda_empty_exposure_listener, exposed))
				empty_exposure_packet(phase, target, temperature, has_gas)
				listener.UnregisterSignal(target, COMSIG_TURF_EXPOSE)
				empty_exposure_packet(phase, target, temperature, has_gas)
			var/datum/gas_mixture/result = native ? target.banda_atmos_cell.read_air() : target.air
			var/list/state = list("processing" = !!(target.flags_1 & ATMOS_IS_PROCESSING_1), "queued" = (target in SSair.atom_process), "ends" = target.exposure_ends,
				"destroyed" = target.to_be_destroyed, "calls" = listener.calls, "observed" = listener.observed_moles, "moles" = result.moles[/datum/gas/nitrogen])
			if(native)
				native_calls = target.temperature_calls
				checks["temperature_notification_[scenario]_matches_dm"] = json_encode(state) == json_encode(reference)
			else
				reference = state
			if(target.flags_1 & ATMOS_IS_PROCESSING_1)
				target.stop_atmos_exposure()
			qdel(listener)
			if(phase)
				qdel(phase)
		var/expected_calls = (scenario in list("empty", "held", "gasless")) ? 0 : 1
		checks["temperature_notification_[scenario]_uses_expected_path"] = native_calls == expected_calls
	return checks

/datum/banda_atmos_cell/publication_probe
	var/publications = 0
	var/hotspot_publications = 0

/datum/banda_atmos_cell/publication_probe/sync_air(list/input, list/metadata, compact = FALSE, input_offset = 0, metadata_offset = 0, input_count = 0, metadata_count = 0, visuals_only = FALSE, list/thermal_baseline)
	publications++
	return ..(arglist(args))

/datum/banda_atmos_cell/publication_probe/sync_hotspot(list/input, list/metadata, input_offset = 0, metadata_offset = 0, input_count = 0, absent = FALSE)
	hotspot_publications++
	return ..(arglist(args))

/// Duplicate service rows can be omitted only while their actual DM state needs no repair.
/datum/controller/subsystem/atmos_phase_test/proc/service_publication_checks()
	var/list/checks = list()
	var/turf/open/target = floor_at(205, 184)
	var/turf/open/cold = floor_at(206, 184)
	cold.banda_air_requested = FALSE
	target.excited = FALSE
	target.banda_air_requested = FALSE
	target.air.set_gas(/datum/gas/nitrogen, 19)
	var/datum/banda_atmos_phase/world_adapter/exchange_probe/phase = new("bandastation_atmos.dll")
	SSair.native_atmos = phase
	phase.register_batch(list(target))
	phase.initializing = FALSE
	phase.native(30)
	var/datum/banda_atmos_cell/publication_probe/cell = new(phase, target, FALSE, target.banda_atmos_id)
	phase.cells.len = max(length(phase.cells), cell.native_id)
	phase.cells[cell.native_id] = cell
	var/lookups = phase.binding_lookups
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_updates_changed_dm_fields"] = target.excited && phase.direct_publications == 1 && phase.native_baselines_ready
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["duplicate_cold_service_omits_dm_projection"] = phase.service_publications_skipped == 1
	checks["publication_reuses_existing_binding"] = phase.binding_lookups == lookups
	var/temperature = target.temperature
	target.temperature += 10
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_repairs_direct_terrain_edits"] = target.temperature == temperature
	target.update_visuals(list(/datum/gas/plasma = 40))
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_clears_stale_overlays"] = !length(target.atmos_overlay_types)
	cell.hotspots_pending = TRUE
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_reconciles_pending_hotspots"] = !cell.hotspots_pending && cell.hotspot_publications == 1 && phase.compact_hotspots == 1
	var/datum/gas_mixture/visible = cell.read_air()
	visible.set_gas(/datum/gas/plasma, 40)
	phase.native(36, cell.native_id, FALSE, banda_atmos_compact_packet(visible, TRUE))
	phase.project_changes()
	checks["visible_cold_publication_omits_absent_hotspot_work"] = length(target.atmos_overlay_types) && cell.hotspot_publications == 1
	var/datum/gas_mixture/held = target.get_readonly_air()
	var/list/old_archive = cell.cached_air.moles_archive
	var/list/old_results = cell.cached_air.reaction_results
	var/publications = phase.direct_publications
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_preserves_held_snapshot_contract"] = held == target.get_readonly_air() && phase.direct_publications == publications + 1 && cell.cached_air.moles_archive != old_archive && cell.cached_air.reaction_results != old_results
	cell.cached_air.moles[/datum/gas/nitrogen] = 999
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["service_publication_repairs_held_mixture_edits"] = cell.cached_air.moles[/datum/gas/nitrogen] == 19 && held.moles[/datum/gas/nitrogen] == 19
	phase.native(37, cell.native_id, SSair.times_fired + 10, 777)
	phase.project_changes()
	checks["service_publication_keeps_archive_metadata_current"] = target.archived_cycle == SSair.times_fired + 10 && target.temperature_archived == 777
	phase.register_batch(list(cold))
	phase.native(19, cold.banda_atmos_id, 0)
	phase.project_changes()
	cold.temperature_archived = null
	phase.native(19, cold.banda_atmos_id, 0)
	phase.project_changes()
	checks["service_publication_distinguishes_null_and_zero"] = !isnull(cold.temperature_archived) && cold.temperature_archived == 0
	qdel(phase)
	return checks

/datum/controller/subsystem/atmos_phase_test/proc/empty_exposure_packet(datum/banda_atmos_phase/world_adapter/phase, turf/open/target, temperature, has_gas)
	if(!phase)
		target.temperature_expose(has_gas ? target.air : null, temperature)
		return
	var/datum/banda_atmos_safe/world_commands/world/packet = new()
	packet.owner = phase
	packet.run_args = list(list(target.banda_atmos_id, target.banda_atmos_cell?.binding_version || 1, 13, temperature, has_gas))
	phase.run_callback(packet)

/turf/open/floor/iron/banda_visual_probe
	var/visual_calls = 0

/turf/open/floor/iron/banda_visual_probe/update_visuals(list/native_moles)
	visual_calls++
	return ..()

/datum/controller/subsystem/atmos_phase_test/proc/packet_visual_checks()
	var/turf/open/floor = floor_at(210, 180)
	var/turf/open/floor/iron/banda_visual_probe/target = floor.ChangeTurf(/turf/open/floor/iron/banda_visual_probe)
	var/list/gases = banda_atmos_gases()
	var/plasma = gases.Find(/datum/gas/plasma) - 1
	var/tritium = gases.Find(/datum/gas/tritium) - 1
	var/nitrogen = gases.Find(/datum/gas/nitrogen) - 1
	var/minimum = GAS_META[META_GAS_MOLES_VISIBLE][/datum/gas/plasma]
	var/states_match = TRUE
	var/unchanged_skipped = TRUE
	for(var/amount in list(0, minimum - 0.0001, minimum, minimum + 0.0001, MOLES_GAS_VISIBLE_STEP * 20 - 0.0001, MOLES_GAS_VISIBLE_STEP * 20, MOLES_GAS_VISIBLE_STEP * 20 + 0.0001, TOTAL_VISIBLE_STATES * MOLES_GAS_VISIBLE_STEP * 2))
		var/list/input = list(0, T20C, CELL_VOLUME, 3, plasma, amount, tritium, amount, nitrogen, 1000)
		target.update_visuals(banda_atmos_packet_moles(input))
		var/list/expected = target.atmos_overlay_types?.Copy()
		target.update_visuals(list())
		banda_atmos_update_packet_visuals(target, input)
		states_match = states_match && json_encode(expected) == json_encode(target.atmos_overlay_types)
		var/calls = target.visual_calls
		banda_atmos_update_packet_visuals(target, input)
		unchanged_skipped = unchanged_skipped && calls == target.visual_calls
	floor = target.ChangeTurf(/turf/open/floor/iron)
	target = floor.ChangeTurf(/turf/open/floor/iron/banda_visual_probe)
	var/list/empty_packet = list(0, T20C, CELL_VOLUME, 0)
	banda_atmos_update_packet_visuals(target, empty_packet)
	states_match = states_match && !length(target.atmos_overlay_types)
	return list("packet_visual_states_match_original" = states_match, "unchanged_packet_visuals_skip_rebuild" = unchanged_skipped)

/datum/controller/subsystem/atmos_phase_test/proc/exchange_modify(turf/open/target, mode)
	var/datum/gas_mixture/air = target.return_air()
	switch(mode)
		if("temperature")
			air.temperature = 333
		if("moles")
			air.moles[/datum/gas/nitrogen] += 2
		if("archive")
			air.temperature_archived = 280
			air.moles_archive[/datum/gas/oxygen] = 4
		if("zero_result")
			air.reaction_results[/datum/gas_reaction/standard/plasmafire] = 0
			air.reaction_results[/datum/gas/nitrogen] = 7
			air.reaction_results[/datum/gas_reaction/standard/tritfire] = null
	return air

/datum/controller/subsystem/atmos_phase_test/proc/thermal_cache_checks()
	var/turf/open/target = floor_at(196, 182)
	target.thermal_conductivity = 0.1
	target.heat_capacity = 500000
	target.temperature = 1300
	target.temperature_archived = 1300
	target.air.set_gas(/datum/gas/nitrogen, 19)
	target.air.temperature = 600
	target.air.temperature_archived = 280
	var/datum/banda_atmos_phase/world_adapter/exchange_probe/phase = new("bandastation_atmos.dll")
	SSair.native_atmos = phase
	phase.register_batch(list(target))
	phase.initializing = FALSE
	var/datum/gas_mixture/held = target.get_readonly_air()
	var/datum/banda_atmos_cell/cell = target.banda_atmos_cell
	var/datum/gas_mixture/live = cell.cached_air
	var/list/moles = live.moles
	var/list/old_archive = live.moles_archive
	var/list/old_results = live.reaction_results
	var/list/held_moles = held.moles
	live.volume = 100
	live.moles[/datum/gas/nitrogen] = 999
	live.reaction_results[/datum/gas_reaction/standard/plasmafire] = 7
	held_moles[/datum/gas/nitrogen] = 2
	calculate_thermal_cache_frame(phase, cell)
	phase.project_changes()
	var/datum/gas_mixture/native_air = cell.read_air()
	var/thermal_changed = phase.thermal_requests == 1 && live.temperature > 600 && live.temperature_archived == 600 && json_encode(banda_atmos_full_packet(live)) == json_encode(banda_atmos_full_packet(native_air))
	var/aliases = live == cell.cached_air && live.moles == moles && live.moles[/datum/gas/nitrogen] == 19 && live.moles_archive != old_archive && live.reaction_results != old_results && old_results[/datum/gas_reaction/standard/plasmafire] == 7 && held.moles == held_moles && held_moles[/datum/gas/nitrogen] == 19 && held.temperature == live.temperature

	// The effect callback borrows the cache and would commit the edit before the test frame.
	phase.apply_frame()
	old_archive = live.moles_archive
	old_archive[/datum/gas/nitrogen] = 500
	var/previous_temperature = live.temperature
	calculate_thermal_cache_frame(phase, cell, TRUE)
	phase.project_changes()
	var/temperature_only = phase.temperature_requests == 1 && live.temperature != previous_temperature && live.temperature_archived == 600 && live.moles_archive != old_archive && live.moles_archive[/datum/gas/nitrogen] == 19 && old_archive[/datum/gas/nitrogen] == 500

	calculate_thermal_cache_frame(phase, cell)
	phase.fail_binding_id = cell.native_id
	var/caught = FALSE
	try
		phase.project_changes()
	catch(var/exception/error)
		caught = error.name == "BANDA_EXPECTED_PUBLICATION_ERROR"
	var/invalidated = !cell.cache_current
	var/requests = phase.thermal_requests
	// Isolate recovery through publication. An effect callback can repair it earlier by borrowing air.
	phase.native(5, list())
	calculate_thermal_cache_frame(phase, cell)
	phase.project_changes()
	native_air = cell.read_air()
	var/recovered = caught && invalidated && phase.thermal_requests == requests && live.temperature == native_air.temperature && held.temperature_archived == native_air.temperature_archived

	calculate_thermal_cache_frame(phase, cell)
	var/datum/gas_mixture/intervening = cell.read_air()
	intervening.set_gas(/datum/gas/nitrogen, 40)
	phase.thermal_intervening_write = banda_atmos_compact_packet(intervening, TRUE)
	requests = phase.thermal_requests
	phase.project_changes()
	var/downgraded = phase.thermal_requests == requests + 1 && !phase.thermal_intervening_write && moles[/datum/gas/nitrogen] == 40 && held_moles[/datum/gas/nitrogen] == 40
	qdel(phase)
	return list("thermal_packet_updates_temperature_and_archive" = thermal_changed, "thermal_packet_preserves_aliases_and_repairs_direct_edits" = aliases, "temperature_packet_preserves_unchanged_archive" = temperature_only, "thermal_packet_recovers_after_missed_publication" = recovered, "thermal_request_reads_gas_after_intervening_write" = downgraded)

/datum/controller/subsystem/atmos_phase_test/proc/calculate_thermal_cache_frame(datum/banda_atmos_phase/world_adapter/phase, datum/banda_atmos_cell/cell, keep_archive = FALSE)
	phase.apply_frame()
	phase.native(19, cell.native_id, 0)
	phase.native(19, cell.native_id, 4)
	if(keep_archive)
		phase.native(37, cell.native_id, SSair.times_fired + 1, cell.target.temperature_archived)
	phase.native(30)
	SSair.times_fired++
	phase.native(16, SSair.times_fired)
	phase.air_cycle = SSair.times_fired

/datum/controller/subsystem/atmos_phase_test/proc/exchange_world_checks()
	var/list/checks = list()
	var/turf/open/target = floor_at(190, 180)
	var/turf/open/passive = floor_at(191, 180)
	target.air.set_gas(/datum/gas/nitrogen, 17)
	target.air.temperature = 300
	target.air.archive()
	var/datum/banda_atmos_phase/world_adapter/exchange_probe/phase = new("bandastation_atmos.dll")
	SSair.native_atmos = phase
	phase.register_batch(list(target, passive))
	phase.native(18, list(), list())
	phase.native(30)
	phase.initializing = FALSE
	var/datum/gas_mixture/held = target.get_readonly_air()
	var/datum/banda_atmos_cell/cell = target.banda_atmos_cell
	var/datum/gas_mixture/working = phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "read"))
	checks["unchanged_borrow_does_not_commit"] = !phase.commits && held != working && !length(phase.working_mixtures)
	phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "temperature"))
	checks["direct_temperature_commits_and_updates_held_readonly"] = phase.commits == 1 && cell.read_air().temperature == 333 && held.temperature == 333
	phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "moles"))
	checks["direct_mole_write_commits"] = phase.commits == 2 && cell.read_air().moles[/datum/gas/nitrogen] == 19
	phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "archive"))
	var/datum/gas_mixture/archived = cell.read_air()
	checks["archive_only_write_commits"] = phase.commits == 3 && archived.temperature_archived == 280 && archived.moles_archive[/datum/gas/oxygen] == 4
	phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "zero_result"))
	var/datum/gas_mixture/with_results = cell.read_air()
	checks["compact_results_keep_present_zero_and_ignore_foreign_null"] = phase.commits == 4 && (/datum/gas_reaction/standard/plasmafire in with_results.reaction_results) && with_results.reaction_results[/datum/gas_reaction/standard/plasmafire] == 0 && !(/datum/gas/nitrogen in with_results.reaction_results) && !(/datum/gas_reaction/standard/tritfire in with_results.reaction_results)
	checks["zero_values_are_conservatively_written"] = !banda_atmos_same_gases(list("gas" = 0), list("gas" = 0))
	checks["key_order_is_observable"] = !banda_atmos_same_gases(list("a" = 1, "b" = 2), list("b" = 2, "a" = 1))
	var/list/presentation = list()
	var/list/full = list()
	phase.native(35, list(cell.native_id, FALSE), presentation)
	phase.native(35, list(cell.native_id, TRUE), full)
	checks["unborrowed_publication_omits_results_and_archive"] = length(presentation) < length(full) && presentation[8 + presentation[7]] == 12
	checks["passive_cell_still_has_no_dm_mixture"] = !passive.air && !passive.banda_atmos_cell
	// Batch decoding must respect both slice boundaries without retaining the output packet.
	var/list/air_packet = cell.read_packet()
	var/list/metadata_packet = cell.read_metadata()
	var/list/batch = list(-999, -998)
	var/air_offset = length(batch)
	batch += air_packet
	batch += -997
	var/metadata_offset = length(batch)
	batch += metadata_packet
	batch += -996
	var/datum/gas_mixture/decoded = banda_atmos_decode_air(batch, batch, cell.native_air_kind, input_offset = air_offset, metadata_offset = metadata_offset)
	checks["batch_offsets_preserve_full_mixture"] = json_encode(banda_atmos_full_packet(decoded)) == json_encode(banda_atmos_full_packet(cell.read_air()))
	checks["batch_offsets_preserve_rendered_gases"] = json_encode(banda_atmos_packet_moles(batch, air_offset)) == json_encode(banda_atmos_packet_moles(air_packet))
	// Return to a result-free mixture so a real unchanged borrow can be skipped.
	var/datum/gas_mixture/turf/clean = new()
	clean.set_gas(/datum/gas/nitrogen, 19)
	clean.temperature = 300
	clean.archive()
	target.replace_turf_air(clean)
	var/list/moles = clean.moles
	var/list/old_archive = clean.moles_archive
	var/list/old_results = clean.reaction_results
	var/obj/machinery/banda_exchange_probe/first = new(target)
	var/obj/machinery/banda_exchange_probe/second = new(target)
	first.air_target = target
	second.air_target = target
	var/list/saved_machinery = SSair.atmos_machinery
	var/saved_state = SSair.state
	var/saved_limit = Master.current_ticklimit
	SSair.atmos_machinery = list()
	SSair.start_processing_machine(second)
	SSair.start_processing_machine(first)
	SSair.state = SS_RUNNING
	Master.current_ticklimit = 1e9
	var/before = phase.commits
	SSair.process_atmos_machinery(FALSE)
	checks["equipment_shares_one_safe_phase"] = first.safe_access && second.safe_access && first.observed_moles == 19 && second.observed_moles == 20 && phase.commits == before + 1
	checks["equipment_kill_results_and_boundary_are_preserved"] = !length(SSair.atmos_machinery) && !phase.in_safe_callback && !length(phase.working_mixtures) && cell.read_air().moles[/datum/gas/nitrogen] == 21
	SSair.start_processing_machine(second)
	SSair.start_processing_machine(first)
	SSair.state = SS_RUNNING
	Master.current_ticklimit = -1
	before = phase.commits
	SSair.process_atmos_machinery(FALSE)
	checks["paused_equipment_flushes_before_return"] = phase.commits == before + 1 && !phase.in_safe_callback && !length(phase.working_mixtures) && length(SSair.currentrun) == 1 && cell.read_air().moles[/datum/gas/nitrogen] == 22
	SSair.state = SS_RUNNING
	Master.current_ticklimit = 1e9
	SSair.process_atmos_machinery(TRUE)
	checks["resumed_equipment_sees_committed_air"] = phase.commits == before + 2 && second.observed_moles == 22 && !length(SSair.atmos_machinery) && !phase.in_safe_callback && cell.read_air().moles[/datum/gas/nitrogen] == 23
	SSair.state = saved_state
	Master.current_ticklimit = saved_limit
	SSair.atmos_machinery = saved_machinery
	qdel(first)
	qdel(second)
	SSair.times_fired++
	phase.run_tick(TRUE)
	checks["publication_preserves_borrowed_moles_identity"] = clean == cell.cached_air && clean.moles == moles && clean.moles[/datum/gas/nitrogen] == 23
	checks["publication_keeps_archive_result_snapshot_semantics"] = clean.moles_archive != old_archive && clean.reaction_results != old_results && old_archive[/datum/gas/nitrogen] == 19
	// Equipment commits keep the old archive; one active pass must update it first.
	phase.native(19, cell.native_id, 0)
	phase.native(30)
	SSair.times_fired++
	phase.run_tick(TRUE)
	phase.native(19, cell.native_id, 0)
	phase.native(30)
	var/list/archive_before_service = clean.moles_archive
	var/list/results_before_service = clean.reaction_results
	var/datum/gas_mixture/service_readonly = target.get_readonly_air()
	var/service_before = phase.service_publications
	SSair.times_fired++
	phase.run_tick(TRUE)
	checks["metadata_only_publication_omits_borrowed_archive"] = phase.service_publications > service_before
	checks["metadata_only_publication_keeps_alias_and_snapshot_contract"] = clean == cell.cached_air && clean.moles == moles && clean.moles_archive != archive_before_service && clean.reaction_results != results_before_service && clean.moles[/datum/gas/nitrogen] == 23 && service_readonly.moles[/datum/gas/nitrogen] == 23
	phase.native(19, cell.native_id, 2)
	phase.project_changes()
	var/was_inactive = !target.excited
	service_before = phase.service_publications
	archive_before_service = clean.moles_archive
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["activation_publishes_service_state_without_gas"] = was_inactive && target.excited && !target.significant_share_ticker && phase.service_publications == service_before + 1 && clean.moles == moles && clean.moles_archive != archive_before_service && service_readonly.moles[/datum/gas/nitrogen] == 23
	clean.moles[/datum/gas/nitrogen] = 999
	service_before = phase.service_publications
	phase.native(19, cell.native_id, 0)
	phase.project_changes()
	checks["activation_reloads_a_mutated_cache"] = clean.moles[/datum/gas/nitrogen] == 23 && cell.can_reuse_air_cache() && phase.service_publications == service_before
	clean.moles[/datum/gas/nitrogen] = 999
	cell.refresh_service_cache(cell.read_metadata(), 0)
	checks["metadata_cache_revalidates_mutated_alias"] = clean.moles[/datum/gas/nitrogen] == 23 && cell.can_reuse_air_cache()
	// Fail after native changes were consumed, before this DM binding receives the new mixture.
	var/datum/gas_mixture/newer = cell.read_air()
	newer.moles[/datum/gas/nitrogen] = 24
	newer.archive()
	phase.native(36, cell.native_id, FALSE, banda_atmos_compact_packet(newer, TRUE))
	phase.fail_binding_id = cell.native_id
	var/publication_failed = FALSE
	try
		phase.apply_frame()
	catch(var/exception/publication_error)
		publication_failed = publication_error.name == "BANDA_EXPECTED_PUBLICATION_ERROR"
	var/stale_cycle = cell.cache_cycle
	phase.native(19, cell.native_id, 0)
	phase.native(30)
	SSair.times_fired++
	phase.native(16, SSair.times_fired)
	phase.air_cycle = SSair.times_fired
	phase.apply_frame()
	var/datum/gas_mixture/native_state = cell.read_air()
	checks["partial_publication_recovers_after_missed_frame"] = publication_failed && clean.moles[/datum/gas/nitrogen] == native_state.moles[/datum/gas/nitrogen] && native_state.moles[/datum/gas/nitrogen] == 24
	log_world("BANDA_STALE_CACHE [json_encode(list("publication_failed" = publication_failed, "stale_cycle" = stale_cycle, "current_cycle" = phase.air_cycle, "cached" = clean.moles[/datum/gas/nitrogen], "native" = native_state.moles[/datum/gas/nitrogen]))]")
	cell.refresh_cache()
	checks["full_publication_recovers_after_missed_frame"] = clean.moles[/datum/gas/nitrogen] == 24
	newer = cell.read_air()
	newer.moles[/datum/gas/nitrogen] = 25
	newer.archive()
	phase.native(36, cell.native_id, FALSE, banda_atmos_compact_packet(newer, TRUE))
	phase.fail_change_read = TRUE
	var/change_read_failed = FALSE
	try
		phase.project_changes()
	catch(var/exception/change_read_error)
		change_read_failed = change_read_error.name == "BANDA_EXPECTED_CHANGE_READ_ERROR"
	var/invalidated_after_read = !cell.cache_current
	var/datum/gas_mixture/after_read_failure = target.get_readonly_air()
	checks["change_list_failure_invalidates_cache"] = change_read_failed && invalidated_after_read && !phase.synchronizing && after_read_failure.moles[/datum/gas/nitrogen] == 25
	qdel(phase)
	var/list/visual_checks = packet_visual_checks()
	for(var/key in visual_checks)
		checks[key] = visual_checks[key]
	checks += exposure_cache_checks()
	checks += empty_exposure_checks()
	checks += service_publication_checks()
	checks += thermal_cache_checks()
	checks += native_projection_checks()
	checks += native_projection_error_checks()
	checks += operation_protocol_checks()
	return checks

/turf/open/floor/iron/banda_projection_probe
	var/datum/gas_mixture/later_air
	var/observed_temperature
	var/throw_on_overlay = FALSE

/turf/open/floor/iron/banda_projection_probe/apply_gas_overlays(list/new_overlay_types)
	. = ..()
	if(later_air)
		observed_temperature = later_air.temperature
		later_air.moles[/datum/gas/nitrogen] = 999
		later_air = null
	if(throw_on_overlay)
		throw EXCEPTION("BANDA_EXPECTED_OVERLAY_PUBLICATION_ERROR")

/// Compare the native writer with the previous packet decoder, including a reentrant alias edit.
/datum/controller/subsystem/atmos_phase_test/proc/native_projection_checks()
	var/list/checks = list()
	var/list/traces = list()
	for(var/direct in list(FALSE, TRUE))
		var/turf/open/start = floor_at(213, 185 + direct)
		var/turf/open/floor/iron/banda_projection_probe/first = start.ChangeTurf(/turf/open/floor/iron/banda_projection_probe)
		var/turf/open/later = floor_at(214, 185 + direct)
		later.air.set_gas(/datum/gas/nitrogen, 23)
		later.air.temperature = 300
		later.air.archive()
		var/datum/banda_atmos_phase/world_adapter/phase = new("bandastation_atmos.dll")
		SSair.native_atmos = phase
		checks["native_projection_available"] = phase.native_baselines_ready
		if(!direct)
			phase.native_baselines_ready = FALSE
		phase.register_batch(list(first, later))
		phase.native(30)
		phase.initializing = FALSE
		var/datum/gas_mixture/held = later.get_readonly_air()
		var/datum/banda_atmos_cell/cell = later.banda_atmos_cell
		first.later_air = cell.cached_air
		var/list/moles = cell.cached_air.moles
		var/datum/gas_mixture/visible = first.banda_atmos_cell ? first.banda_atmos_cell.read_air() : new()
		visible.set_gas(/datum/gas/plasma, 40)
		phase.native(36, first.banda_atmos_id, FALSE, banda_atmos_compact_packet(visible, TRUE))
		var/datum/gas_mixture/replacement = cell.read_air()
		replacement.temperature = 450
		phase.native(36, cell.native_id, FALSE, banda_atmos_compact_packet(replacement, TRUE))
		phase.project_changes()
		checks["native_projection_callback_order_[direct]"] = first.observed_temperature == 300 && held.temperature == 450 && held.moles[/datum/gas/nitrogen] == 23 && cell.cached_air.moles == moles
		traces += json_encode(banda_atmos_full_packet(held))
		if(direct)
			checks["native_projection_used_without_dm_baseline"] = phase.direct_publications == 2 && !islist(cell.committed_air) && cell.can_reuse_air_cache()
			var/list/snapshot = cell.committed_snapshot()
			cell.cached_air.moles[/datum/gas/nitrogen] = 24
			checks["native_baseline_detached_from_live_lists"] = !cell.can_reuse_air_cache() && snapshot[4][/datum/gas/nitrogen] == 23
			cell.cached_air.moles[/datum/gas/nitrogen] = 23
			checks["native_baseline_recognizes_restored_values"] = cell.can_reuse_air_cache()
			cell.cached_air.reaction_results = list(/datum/gas_reaction/standard/plasmafire = 0, /datum/gas/nitrogen = null)
			cell.remember_air(cell.cached_air)
			snapshot = cell.committed_snapshot()
			checks["native_baseline_keeps_zero_null_and_key_order"] = !cell.can_reuse_air_cache() && length(snapshot[6]) == 2 && snapshot[6][1] == /datum/gas_reaction/standard/plasmafire && snapshot[6][2] == /datum/gas/nitrogen && !isnull(snapshot[6][/datum/gas_reaction/standard/plasmafire]) && isnull(snapshot[6][/datum/gas/nitrogen])
		qdel(phase)
	checks["native_projection_matches_legacy_packet_state"] = traces[1] == traces[2]
	return checks

/// Aborting a callback must free the native cursor and invalidate every undelivered cache.
/datum/controller/subsystem/atmos_phase_test/proc/native_projection_error_checks()
	var/list/checks = list()
	for(var/direct in list(FALSE, TRUE))
		var/turf/open/start = floor_at(215, 188 + direct)
		var/turf/open/floor/iron/banda_projection_probe/first = start.ChangeTurf(/turf/open/floor/iron/banda_projection_probe)
		var/turf/open/later = floor_at(216, 188 + direct)
		later.air.set_gas(/datum/gas/nitrogen, 23)
		var/datum/banda_atmos_phase/world_adapter/exchange_probe/phase = new("bandastation_atmos.dll")
		SSair.native_atmos = phase
		if(!direct)
			phase.native_baselines_ready = FALSE
		phase.register_batch(list(first, later))
		phase.native(30)
		phase.initializing = FALSE
		var/datum/gas_mixture/held = later.get_readonly_air()
		var/datum/gas_mixture/visible = new()
		visible.set_gas(/datum/gas/plasma, 40)
		phase.native(36, first.banda_atmos_id, FALSE, banda_atmos_compact_packet(visible, TRUE))
		var/datum/banda_atmos_cell/cell = later.banda_atmos_cell
		var/datum/gas_mixture/replacement = cell.read_air()
		replacement.moles[/datum/gas/nitrogen] = 27
		phase.native(36, cell.native_id, FALSE, banda_atmos_compact_packet(replacement, TRUE))
		first.throw_on_overlay = TRUE
		var/caught = FALSE
		try
			phase.project_changes()
		catch(var/exception/error)
			caught = error.name == "BANDA_EXPECTED_OVERLAY_PUBLICATION_ERROR"
		checks["projection_callback_failure_invalidates_undelivered_cache_[direct]"] = caught && !phase.synchronizing && !cell.cache_current && held.moles[/datum/gas/nitrogen] == 23 && later.get_readonly_air().moles[/datum/gas/nitrogen] == 27
		if(direct)
			var/released = FALSE
			try
				phase.native(76, phase.last_projection_batch, phase, list(), list())
			catch(var/exception/release_error)
				released = !!findtext(release_error.name, "Missing publication batch")
			checks["projection_callback_failure_releases_native_cursor"] = released
		first.throw_on_overlay = FALSE
		qdel(phase)
	return checks

/// Compare partial writes across an equipment exception with the original DM path.
/datum/controller/subsystem/atmos_phase_test/proc/exchange_error_contract()
	var/list/result = list()
	for(var/backend in list("dm", "rust"))
		var/turf/open/target = floor_at(backend == "dm" ? 192 : 193, 180)
		target.air.set_gas(/datum/gas/nitrogen, 100)
		target.air.temperature = 300
		target.air.archive()
		var/datum/banda_atmos_phase/world_adapter/phase
		if(backend == "rust")
			phase = new("bandastation_atmos.dll")
			SSair.native_atmos = phase
			phase.register_batch(list(target))
			phase.native(18, list(), list())
			phase.native(30)
			phase.initializing = FALSE
		var/obj/machinery/banda_exchange_probe/first = new(target)
		var/obj/machinery/banda_exchange_probe/second = new(target)
		first.air_target = target
		second.air_target = target
		second.throw_after_write = TRUE
		var/list/saved_machinery = SSair.atmos_machinery
		var/saved_state = SSair.state
		var/saved_limit = Master.current_ticklimit
		SSair.atmos_machinery = list()
		SSair.start_processing_machine(second)
		SSair.start_processing_machine(first)
		SSair.state = SS_RUNNING
		Master.current_ticklimit = 1e9
		var/caught = FALSE
		try
			SSair.process_atmos_machinery(FALSE)
		catch(var/exception/error)
			caught = error.name == "BANDA_EXCHANGE_EXPECTED_EQUIPMENT_FAILURE"
		SSair.state = saved_state
		Master.current_ticklimit = saved_limit
		SSair.atmos_machinery = saved_machinery
		var/datum/gas_mixture/observed = phase ? target.banda_atmos_cell.read_air() : target.air
		result["[backend]_caught"] = caught
		result["[backend]_moles"] = observed.moles[/datum/gas/nitrogen]
		qdel(first)
		qdel(second)
		if(phase)
			qdel(phase)
	return result

/datum/banda_exchange_listener
	var/turf/tracked
	var/datum/gas_mixture/seen_air
	var/exposures = 0

/datum/banda_exchange_listener/proc/listen(turf/target)
	tracked = target
	RegisterSignal(target, COMSIG_TURF_EXPOSE, PROC_REF(on_expose))

/datum/banda_exchange_listener/proc/on_expose(datum/source, datum/gas_mixture/air, temperature)
	SIGNAL_HANDLER
	exposures++
	seen_air = air
	air.moles[/datum/gas/nitrogen] += 2

/datum/banda_exchange_listener/Destroy()
	if(tracked)
		UnregisterSignal(tracked, COMSIG_TURF_EXPOSE)
	tracked = null
	seen_air = null
	return ..()

/obj/item/wrench/banda_exchange_alias
	var/datum/gas_mixture/stored_air
	var/fire_calls = 0

/obj/item/wrench/banda_exchange_alias/fire_act(temperature, volume)
	fire_calls++
	stored_air.moles[/datum/gas/nitrogen] += 3

/obj/item/wrench/banda_exchange_alias/Destroy()
	stored_air = null
	return ..()

/datum/controller/subsystem/atmos_phase_test/proc/exchange_effect_checks()
	var/list/checks = list()
	var/index = 0
	for(var/scenario in list("bare", "listener", "damage", "coal", "held"))
		var/turf/open/target = floor_at(200 + index++, 190)
		target.air.set_gas(/datum/gas/nitrogen, 17)
		target.air.temperature = 300
		target.air.archive()
		if(scenario == "damage")
			target.heat_capacity = 1
		var/datum/banda_atmos_phase/world_adapter/phase = new("bandastation_atmos.dll")
		SSair.native_atmos = phase
		phase.register_batch(list(target))
		phase.native(18, list(target.banda_atmos_id), list())
		phase.native(30)
		phase.initializing = FALSE
		var/datum/banda_exchange_listener/listener
		var/obj/item/wrench/banda_exchange_alias/alias
		if(scenario == "listener")
			listener = new()
			listener.listen(target)
		if(scenario == "coal" || scenario == "held")
			if(scenario == "coal")
				new /obj/item/stack/sheet/mineral/coal(target, 1)
			else
				alias = new(target)
				alias.stored_air = phase.invoke(CALLBACK(src, PROC_REF(exchange_modify), target, "read"))
			var/datum/banda_atmos_safe/world_commands/world/executor = new()
			executor.owner = phase
			executor.run_args = list(list(target.banda_atmos_id, phase.ensure_binding(target).binding_version, 9, 700, CELL_VOLUME))
			phase.run_callback(executor)
		else
			SSair.times_fired++
			phase.run_tick(TRUE)
		var/datum/banda_atmos_cell/cell = target.banda_atmos_cell
		switch(scenario)
			if("bare")
				checks["bare_turf_exposure_needs_no_dm_air"] = !cell.cached_air && !cell.readonly_air && cell.read_air().moles[/datum/gas/nitrogen] == 17
			if("listener")
				checks["turf_signal_receives_live_air_and_keeps_direct_writes"] = listener.exposures == 1 && listener.seen_air == cell.cached_air && cell.read_air().moles[/datum/gas/nitrogen] == 19
			if("damage")
				checks["damaged_turf_still_queues_exposure"] = !!cell.cached_air && (target in SSair.atom_process) && (target.flags_1 & ATMOS_IS_PROCESSING_1)
			if("coal")
				checks["real_coal_can_create_air_without_preborrow"] = cell.read_air().moles[/datum/gas/carbon_dioxide] == 10
			if("held")
				checks["fire_effect_keeps_direct_writes_to_held_air"] = alias.fire_calls == 1 && alias.stored_air == cell.cached_air && cell.read_air().moles[/datum/gas/nitrogen] == 20
		if(listener)
			qdel(listener)
		if(alias)
			qdel(alias)
		SSair.atom_process -= target
		target.flags_1 &= ~ATMOS_IS_PROCESSING_1
		qdel(phase)
	return checks

/// The shared helper must retain both LINDA archives, the cycle and activation, including immutable space.
/datum/controller/subsystem/atmos_phase_test/proc/exchange_spawn_after_replacement(turf/open/target)
	target = target.ChangeTurf(/turf/open/floor/wood, flags = CHANGETURF_INHERIT_AIR)
	target.temperature = 325
	target.atmos_spawn_air("[GAS_CO2]=10;[TURF_TEMPERATURE(700)]")
	return target

/datum/controller/subsystem/atmos_phase_test/proc/exchange_spawn_checks()
	var/list/checks = list()
	var/index = 0
	for(var/mixture_kind in list("floor", "space", "replacement"))
		var/list/observed = list()
		for(var/backend in list("dm", "rust"))
			var/turf/open/target = floor_at(220 + index++, 190)
			if(mixture_kind == "space")
				target = target.ChangeTurf(/turf/open/space)
			else
				target.air.set_gas(/datum/gas/nitrogen, 17)
				target.air.temperature = 300
				target.air.archive()
			target.temperature = 325
			var/datum/banda_atmos_phase/world_adapter/phase
			if(backend == "rust")
				phase = new("bandastation_atmos.dll")
				SSair.native_atmos = phase
				phase.register_batch(list(target))
				phase.native(18, list(), list())
				phase.native(30)
				phase.initializing = FALSE
			if(mixture_kind == "replacement")
				if(phase)
					target = phase.invoke(CALLBACK(src, PROC_REF(exchange_spawn_after_replacement), target))
					phase.apply_frame()
				else
					target = exchange_spawn_after_replacement(target)
			else
				target.atmos_spawn_air("[GAS_CO2]=10;[TURF_TEMPERATURE(700)]")
			var/datum/gas_mixture/air = target.air
			var/cycle = target.archived_cycle
			var/terrain_archive = target.temperature_archived
			var/active = (target in SSair.active_turfs)
			if(phase)
				var/datum/banda_atmos_cell/cell = target.banda_atmos_cell
				air = cell.read_air()
				var/list/metadata = cell.read_metadata()
				cycle = metadata[3]
				terrain_archive = metadata[2]
				active = metadata[6]
			observed[backend] = list("packet" = banda_atmos_full_packet(air), "cycle" = cycle, "terrain_archive" = terrain_archive, "active" = !!active)
			if(phase)
				qdel(phase)
		checks["[mixture_kind]_spawn_full_state_matches_dm"] = json_encode(observed["dm"]["packet"]) == json_encode(observed["rust"]["packet"])
		observed["dm"] -= "packet"
		observed["rust"] -= "packet"
		log_world("BANDA_ATMOS_SPAWN_META [mixture_kind]: [json_encode(observed)]")
		checks["[mixture_kind]_spawn_archive_cycle_and_activation_match_dm"] = json_encode(observed["dm"]) == json_encode(observed["rust"]) && observed["rust"]["cycle"] == SSair.times_fired
	return checks
