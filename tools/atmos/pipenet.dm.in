// Original reconcile_air() and copy_from_ratio() are included by pipenet.py.
/datum/gas_mixture
	var/pipeline_cycle = -1
	var/temperature_archived = 123
	var/last_share = 42

/datum/pipeline
	var/datum/gas_mixture/air
	var/list/other_airs = list()
	var/list/require_custom_reconcilation = list()

/obj/machinery/atmospherics/components/proc/return_pipenets_for_reconcilation(datum/pipeline/requester)
	return list()

/obj/machinery/atmospherics/components/proc/return_airs_for_reconcilation(datum/pipeline/requester)
	return list()

world
	maxx = 1
	maxy = 1
	maxz = 1

/world/New()
	..()
	oracle_setup()
	var/list/output = list()
	var/list/gases = oracle_gases()
	var/elapsed = 0
	for(var/list/test in json_decode(file2text("cases.json")))
		var/list/mixtures = list()
		for(var/list/input in test["mixtures"])
			// Zero volume is assigned after construction, as in portables_connector.
			var/datum/gas_mixture/air = new
			air.volume = input["volume"]
			air.temperature = input["temperature"]
			for(var/list/pair in input["gases"])
				air.moles[gases[pair[1] + 1]] = pair[2]
			air.moles_archive[/datum/gas/plasma] = 123
			air.reaction_results["sentinel"] = 17
			mixtures += air
		var/datum/pipeline/network = new
		var/list/order = test["order"]
		for(var/i in 1 to length(order) - 1)
			network.other_airs += mixtures[order[i] + 1]
		network.air = mixtures[order[length(order)] + 1]
		var/steps = test["steps"] || 1
		var/started = world.timeofday
		for(var/step in 1 to steps)
			network.reconcile_air()
		elapsed += (world.timeofday - started + 864000) % 864000
		var/list/states = list()
		for(var/datum/gas_mixture/air as anything in mixtures)
			var/list/moles = list()
			var/list/keys = list()
			for(var/gas in gases)
				moles += num2text(air.moles[gas] || 0, 9)
			for(var/gas in air.moles)
				keys += gases.Find(gas) - 1
			states += list(list("temperature" = num2text(air.temperature, 9), "moles" = moles, "keys" = keys,
				"archive" = air.moles_archive[/datum/gas/plasma], "result" = air.reaction_results["sentinel"],
				"archived_temperature" = air.temperature_archived, "last_share" = air.last_share))
		output += list(states)
	text2file(json_encode(list("version" = "[world.byond_version].[world.byond_build]", "cases" = output,
		"elapsed_seconds" = elapsed / 10)), "dm-output.json")
	shutdown()
